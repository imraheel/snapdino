{
	"name": "SnapDino",
	"version": "0.0.1-beta",
	"description": "SnapDino - Image crop, resize and enhance made easy",
	"author": "Raheel Khan",
	"homepage": "./",
	"main": "app/electron.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imraheel/snapdino.git"
	},
	"scripts": {
		"start": "react-scripts start",
		"build": "GENERATE_SOURCEMAP=false react-scripts build",
		"dev": "concurrently -k \"BROWSER=none npm start\" \"npm:electron\"",
		"electron": "electron .",
		"pack": "electron-builder --dir",
		"build:mac": "electron-builder --mac",
		"build:win": "electron-builder --win",
		"build:linux": "electron-builder --linux deb tar.gz",
		"make:icons": "./node_modules/.bin/electron-icon-builder --input=./public/app-icon/icon-1024.png --output=./public",
		"build:test": "rm -rf dist && rm -rf build && npm run make:icons && npm run build && npm run build:mac"
	},
	"build": {
		"appId": "com.snapdino.app",
		"productName": "SnapDino",
		"extends": null,
		"extraMetadata": {
			"main": "./app/electron.js"
		},
		"files": [
			"./build/**/*",
			"./app/**/*",
			"node_modules/**/*",
			"package.json"
		],
		"directories": {
			"buildResources": "."
		},
		"mac": {
			"icon": "./build/icons/mac/icon.icns",
			"target": {
				"target": "default",
				"arch": "universal"
			}
		},
		"win": {
			"icon": "./build/icons/win/icon.ico",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"ia32"
					]
				}
			]
		},
		"linux": {
			"icon": "./build/icons/png/256x256.png"
		}
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"@emotion/react": "^11.11.0",
		"@emotion/styled": "^11.11.0",
		"@mui/icons-material": "^5.11.16",
		"@mui/lab": "^5.0.0-alpha.131",
		"@mui/material": "^5.13.2",
		"@reduxjs/toolkit": "^1.9.5",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^14.0.0",
		"@testing-library/user-event": "^14.4.3",
		"blueimp-load-image": "^5.16.0",
		"classnames": "^2.3.2",
		"core-js": "^3.30.2",
		"electron-is-dev": "^2.0.0",
		"enzyme": "^3.11.0",
		"prop-types": "^15.8.1",
		"react": "^18.2.0",
		"react-app-polyfill": "^3.0.0",
		"react-dom": "^18.2.0",
		"react-redux": "^8.0.5",
		"react-scripts": "5.0.1",
		"redux": "4.2.1",
		"smartcrop": "^2.0.5",
		"uuid": "^9.0.0",
		"web-vitals": "^3.3.1"
	},
	"devDependencies": {
		"concurrently": "^8.0.1",
		"electron": "^24.3.1",
		"electron-builder": "^23.6.0",
		"electron-icon-builder": "^2.0.1",
		"sass": "^1.62.1",
		"wait-on": "^7.0.1"
	},
	"engines": {
		"node": ">=10",
		"npm": ">=6"
	}
}
